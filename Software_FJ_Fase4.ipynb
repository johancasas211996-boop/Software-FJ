    "from abc import ABC, abstractmethod\n",
    "\n",
    "\n",
    "class Entidad(ABC):\n",
    "\n",
    "    def __init__(self, identificador, nombre):  \n",
    "        self._identificador = identificador\n",
    "        self._nombre = nombre\n",
    "\n",
    "    @property\n",
    "    def identificador(self):\n",
    "        return self._identificador\n",
    "\n",
    "    @property\n",
    "    def nombre(self):\n",
    "        return self._nombre\n",
    "\n",
    "    @abstractmethod\n",
    "    def validar(self):\n",
    "        pass\n",
    "\n",
    "    @abstractmethod\n",
    "    def describir(self):\n",
    "        pass\n"
